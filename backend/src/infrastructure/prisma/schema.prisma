// Prisma schema for LLD Practice Platform
// Datasource: SQLite for zero-setup, file-based relational storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum SubmissionStatus {
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}

enum EvaluatorType {
  DETERMINISTIC
  AI
}

model Problem {
  id                 String    @id @default(uuid())
  title              String
  description        String
  difficulty         String    // Maps to Difficulty enum
  futureRequirements String    // Stored as JSON array of strings
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  attempts           Attempt[]

  @@map("problems")
}

model Attempt {
  id                         String       @id @default(uuid())
  problemId                  String
  learnerId                  String
  status                     String       @default("IN_PROGRESS") // AttemptStatus
  assumptions                String       @default("")
  classesAndResponsibilities String       @default("")
  relationships              String       @default("")
  extensibilityAnswer        String       @default("")
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  problem                    Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissions                Submission[]

  @@map("attempts")
}

model Submission {
  id                         String        @id @default(uuid())
  attemptId                  String
  status                     String        @default("SUBMITTED") // SubmissionStatus
  contentHash                String        // Used for idempotency checks
  assumptions                String
  classesAndResponsibilities String
  relationships              String
  extensibilityAnswer        String
  failureReason              String?
  createdAt                  DateTime      @default(now())
  completedAt                DateTime?

  attempt                    Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  evaluations                Evaluation[]

  @@index([attemptId, contentHash])
  @@map("submissions")
}

model Evaluation {
  id             String       @id @default(uuid())
  submissionId   String
  evaluatorType  String       // EvaluatorType: DETERMINISTIC | AI
  rubricResults  String       // JSON-encoded CriterionResult[]
  overallSummary String
  metadata       String?      // JSON-encoded metadata
  createdAt      DateTime     @default(now())

  submission     Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("evaluations")
}
