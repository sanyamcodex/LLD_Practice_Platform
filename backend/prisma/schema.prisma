// Canonical Prisma schema for LLD Practice Platform
// Configured for PostgreSQL (Neon) and Render cloud deployment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum SubmissionStatus {
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}

enum EvaluatorType {
  DETERMINISTIC
  AI
}

model Problem {
  id                 String     @id @default(uuid())
  title              String
  description        String
  difficulty         Difficulty
  futureRequirements String     // Stored as JSON array of strings
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  attempts           Attempt[]

  @@map("problems")
}

model Attempt {
  id                         String        @id @default(uuid())
  problemId                  String
  learnerId                  String
  status                     AttemptStatus @default(IN_PROGRESS)
  assumptions                String        @default("")
  classesAndResponsibilities String        @default("")
  relationships              String        @default("")
  extensibilityAnswer        String        @default("")
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  problem                    Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissions                Submission[]

  @@map("attempts")
}

model Submission {
  id                         String           @id @default(uuid())
  attemptId                  String
  status                     SubmissionStatus @default(SUBMITTED)
  contentHash                String           // Used for idempotency checks
  assumptions                String
  classesAndResponsibilities String
  relationships              String
  extensibilityAnswer        String
  failureReason              String?
  createdAt                  DateTime         @default(now())
  completedAt                DateTime?

  attempt                    Attempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  evaluations                Evaluation[]

  @@index([attemptId, contentHash])
  @@map("submissions")
}

model Evaluation {
  id             String        @id @default(uuid())
  submissionId   String
  evaluatorType  EvaluatorType
  rubricResults  String        // JSON-encoded CriterionResult[]
  overallSummary String
  metadata       String?       // JSON-encoded metadata
  createdAt      DateTime      @default(now())

  submission     Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("evaluations")
}
